{
  "name": "@wanaka/game-agent",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/entry.js",
  "exports": {
    ".": "./src/entry.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../tooling/bundle-service.mjs src/entry.ts src/entry-agentcore.ts src/entry-cli.ts src/entry-local.ts src/entry-preflight.ts src/entry-typescript-toolchain-probe.ts",
    "dev:standalone": "tsx watch src/entry.ts",
    "start": "node dist/entry.js",
    "typecheck": "wanaka-typescript-toolchain exec --identity game-agent --workspace-package package.json --label game-agent-typecheck --tsconfig tsconfig.json -- --noEmit",
    "gen:env": "tsx ../../tooling/gen-env-example.ts --src src/env.ts --schema-var EnvObject --out .env.example --tsconfig tsconfig.json --regen 'pnpm --filter @wanaka/game-agent gen:env'",
    "gen:env:check": "tsx ../../tooling/gen-env-example.ts --src src/env.ts --schema-var EnvObject --out .env.example --tsconfig tsconfig.json --regen 'pnpm --filter @wanaka/game-agent gen:env' --check",
    "gen:room-multiplayer-preview-fixture": "tsx scripts/gen-room-multiplayer-preview-fixture.ts",
    "gen:room-multiplayer-preview-fixture:check": "tsx scripts/gen-room-multiplayer-preview-fixture.ts --check",
    "lint": "eslint src/ test/ --no-error-on-unmatched-pattern",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:integration",
    "stop:test": "vitest related --run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:component": "vitest run -c vitest.component.config.ts --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "test:docker-integration": "vitest run -c vitest.docker-integration.config.ts --passWithNoTests",
    "lint:fix": "eslint src/ test/ --fix --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
