{
    "name": "wechatgame",
    "version": "1.0.0",
    "author": "Cocos",
    "description": "Wechat game platform plugin",
    "license": "ISC",
    "type": "commonjs",
    "contributes": {
        "builder": {
            "register": true,
            "platform": "wechatgame",
            "config": "./dist/config",
            "hooks": "./dist/hooks"
        },
        "pinkBuilder": {
            "platform": "wechatgame",
            "customView": "./dist/view/build-config.js",
            "customExtensionHost": "./dist/view/build-config-host.js",
            "customFields": [
                "separateEngine",
                "highPerformanceMode"
            ],
            "card": "./static/card.png",
            "icon": "./static/icon.png"
        },
        "pinkConfiguration": [
            {
                "id": "pinkProgramManagerSettings",
                "title": "Program Manager",
                "group": "general",
                "order": 1,
                "properties": {
                    "programManager.wechatDevTools": {
                        "type": "string",
                        "default": "",
                        "title": "WeChat DevTools",
                        "editPresentation": "filepath",
                        "editPresentationOptions": {
                            "placeholder": "Select WeChat DevTools executable (cli / cli.bat)"
                        },
                        "scope": ["global"]
                    }
                }
            }
        ]
    },
    "scripts": {
        "build-adapter": "node scripts/build-adapter.js",
        "build-view": "node scripts/build-view.js",
        "watch-view": "node scripts/build-view.js --watch",
        "watch": "node scripts/watch.js",
        "build": "npm run build-view & npm run build-adapter & tsc"
    },
    "devDependencies": {
        "@babel/core": "^7.13.10",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/plugin-proposal-export-default-from": "^7.17.12",
        "@babel/preset-env": "7.8.7",
        "@types/react": "^19.0.0",
        "babelify": "^10.0.0",
        "browserify": "^17.0.0",
        "chalk": "^4.1.2",
        "esbuild": "^0.25.0",
        "gulp": "^4.0.2",
        "gulp-rename": "^2.0.0",
        "gulp-uglify": "^3.0.2",
        "react": "^19.0.0",
        "vinyl-buffer": "^1.0.1",
        "vinyl-source-stream": "^2.0.0"
    }
}